# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=bjp_db
DB_USER=bjp_user
DB_PASS=your-database-password
DB_HOST=localhost
DB_PORT=3306

# Email (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@bjptechnologies.co.tz
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=BJP Technologies <info@bjptechnologies.co.tz>
CONTACT_EMAIL=info@bjptechnologies.co.tz

# GitHub webhook deployment
GITHUB_WEBHOOK_SECRET=your-random-secret-here

# Google Analytics Data API (Phase 2 — in-admin dashboard)
# Numeric Property ID (NOT the G- Measurement ID). Capture the OAuth values
# once with: python manage.py ga_capture_token /path/to/oauth-client.json
GA_PROPERTY_ID=
GA_OAUTH_CLIENT_ID=
GA_OAUTH_CLIENT_SECRET=
GA_OAUTH_REFRESH_TOKEN=
